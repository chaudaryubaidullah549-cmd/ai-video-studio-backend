# ==============================================================================
# AI Video Studio Backend - environment configuration
# Copy this file to `.env` and fill in the values you need.
# NEVER commit your real .env file.
# ==============================================================================

# --- General ---
ENVIRONMENT=development
DEBUG=true

# MOCK_MODE=true runs the ENTIRE pipeline (story, characters, scenes,
# video, voice, music, sfx, rendering) with no external API calls and no
# cost, producing real (if placeholder) MP4/WAV files via FFmpeg. This is
# the recommended setting for frontend development against this API.
MOCK_MODE=true

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- CORS ---
# Comma-separated list of allowed frontend origins. Add your Lovable
# preview/production URL(s) here. Do not use "*" outside DEBUG.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# --- Database ---
# SQLite by default. For production, point this at Postgres, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/ai_video_studio
DATABASE_URL=sqlite:///./data/app.db

# --- Storage ---
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
# Base URL this backend is reachable at - used to build /media file URLs
# returned to the frontend. Update for your deployment.
PUBLIC_BASE_URL=http://localhost:8000

# --- Hugging Face Inference Providers ---
# Create a fine-grained token with "Inference Providers" permission at:
# https://huggingface.co/settings/tokens/new?ownUserPermissions=inference.serverless.write&tokenType=fineGrained
HF_TOKEN=
# Recommended models per https://huggingface.co/docs/inference-providers/en/tasks/text-to-video
# (fast):    Lightricks/LTX-Video-0.9.8-13B-distilled
# (quality): tencent/HunyuanVideo
HF_VIDEO_MODEL=Lightricks/LTX-Video-0.9.8-13B-distilled
# "auto" lets Hugging Face route to the first available provider for the
# chosen model. You can pin a specific provider (e.g. "fal-ai", "replicate").
HF_PROVIDER=auto
HF_LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
# Optional: pin a specific TTS model. Leave blank to use the provider's
# recommended default for the text-to-speech task.
HF_TTS_MODEL=

# --- Optional alternate providers (not required to run the backend) ---
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# --- Generation limits ---
MAX_PROJECT_DURATION_SECONDS=180
MAX_SCENE_DURATION_SECONDS=8
DEFAULT_SCENE_DURATION_SECONDS=5
PROVIDER_MAX_RETRIES=3
PROVIDER_TIMEOUT_SECONDS=120
PROVIDER_POLL_INTERVAL_SECONDS=3.0

# --- Security / request limits ---
MAX_REQUEST_BODY_BYTES=2097152
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- FFmpeg ---
# Override only if ffmpeg/ffprobe are not on PATH.
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
